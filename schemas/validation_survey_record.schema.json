{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation Survey Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "factorforge_version",
    "optimization_profile",
    "host_organism",
    "protein_class",
    "expression_system_assay_type",
    "harvest_timepoint",
    "replicate_category",
    "comparison_result",
    "expression_result",
    "approximate_yield_range",
    "consent_right_to_share",
    "consent_no_prohibited_data",
    "consent_internal_use",
    "consent_public_summary"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "0.1.0"},
    "factorforge_version": {"type": "string"},
    "optimization_profile": {"type": "string"},
    "host_organism": {"type": "string"},
    "protein_class": {"type": "string"},
    "subcellular_targeting_category": {"type": "string"},
    "promoter_category": {"type": "string"},
    "expression_system_assay_type": {"type": "string"},
    "native_sequence_control_status": {"type": "string"},
    "harvest_timepoint": {"type": "string"},
    "replicate_category": {"type": "string"},
    "comparison_result": {"type": "string"},
    "expression_result": {"type": "string"},
    "approximate_yield_range": {"type": "string"},
    "non_confidential_construct_alias": {"type": "string"},
    "non_confidential_notes": {"type": "string"},
    "consent_right_to_share": {"type": "boolean"},
    "consent_no_prohibited_data": {"type": "boolean"},
    "consent_internal_use": {"type": "boolean"},
    "consent_public_summary": {"type": "boolean"}
  }
}
